# Copy to .env for local development. NEVER commit .env. On Render, set these in the dashboard.
ANTHROPIC_API_KEY=
# Required to use /api/admin/* (kill switch, evaluation runner). Long random string.
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://rishi-creator-11.github.io,http://localhost:5173,http://localhost:4173
# Public-demo controls (defaults shown)
PUBLIC_CHAT_ENABLED=true
DAILY_BUDGET_USD=2
MAX_TURNS_PER_SESSION=15
SESSION_COST_CAP_USD=0.05
IP_CHAT_PER_WINDOW=40
MAX_CONCURRENT_CHATS=8
EVAL_BUDGET_USD=3
